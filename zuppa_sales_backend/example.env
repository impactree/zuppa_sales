# DUMP THE MASTER QUESTION
pg_dump -U <username> -d <db_name> -h localhost -t master_modules -t master_indicators -t master_questions -t question_options -t mixed_type_questions -t master_subindicators --data-only --inserts > master_question_dump.sql


psql -U <username> -d <db_name> -h localhost < <sql_file>

psql -U <username> -d <db_name> -h localhost < master_question_dump.sql


 FIND AND REPLACE
const { schema } = queryRunner.connection
      .options as PostgresConnectionOptions;
CREATE TABLE "   ===> CREATE TABLE "${schema}"."
ALTER TABLE " =====> ALTER TABLE "${schema}"."
DROP TABLE "  ======> DROP TABLE "${schema}"."
REFERENCES " ======> REFERENCES "${schema}"."
ON " ======> ON "${schema}"."
"public".  => "${schema}".
PK_ =====> PK_${schema}_
FK_ =====  FK_${schema}_
IDX_ ===== IDX_${schema}_
UQ_ ===== UQ_${schema}_
REL_ ===== REL_${schema}_


